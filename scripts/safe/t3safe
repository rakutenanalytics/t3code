#!/usr/bin/env bash
set -euo pipefail

script_path=${BASH_SOURCE[0]}
while [[ -L "$script_path" ]]; do
  script_directory=$(cd -P "$(dirname "$script_path")" && pwd)
  target=$(readlink "$script_path")
  if [[ "$target" = /* ]]; then script_path=$target; else script_path="$script_directory/$target"; fi
done
release_dir=$(cd -P "$(dirname "$script_path")" && pwd)
fail() { printf 't3safe: %s\n' "$*" >&2; exit 1; }
case "${1:-help}" in
  version)
    [[ -f "$release_dir/VERSION" ]] || fail 'No installed VERSION receipt.'
    cat "$release_dir/VERSION"
    ;;
  update)
    shift
    version=
    forwarded=()
    while [[ $# -gt 0 ]]; do
      if [[ "$1" == --version ]]; then
        [[ $# -ge 2 ]] || fail '--version needs a tag'
        version=$2
        shift 2
      else
        forwarded+=("$1")
        shift
      fi
    done
    work=$(mktemp -d "${TMPDIR:-/tmp}/t3safe-update.XXXXXX")
    trap 'rm -rf "$work"' EXIT
    repository=rakutenanalytics/t3code
    command -v gh >/dev/null 2>&1 || fail 'GitHub CLI required. Install gh, then run: gh auth login --hostname github.com'
    gh auth status --hostname github.com >/dev/null 2>&1 || fail 'GitHub CLI login required. Run: gh auth login --hostname github.com'
    if [[ -z "$version" ]]; then
      version=$(gh release view --repo "$repository" --json tagName --jq .tagName)
    fi
    [[ "$version" =~ ^v[0-9]+\.[0-9]+\.[0-9]+-safe\.[0-9]+$ ]] || fail 'Expected vX.Y.Z-safe.N.'
    installer="$work/install.sh"
    download_asset() {
      local name=$1
      gh release download --repo "$repository" "$version" --pattern "$name" --output "$work/$name"
    }
    download_asset SHA256SUMS
    download_asset install.sh
    expected=$(awk '$2 == "install.sh" || $2 == "./install.sh" { print $1 }' "$work/SHA256SUMS")
    [[ "$expected" =~ ^[a-fA-F0-9]{64}$ ]] || fail 'Missing or duplicate installer checksum.'
    actual=$(shasum -a 256 "$installer")
    [[ "${actual%% *}" == "$expected" ]] || fail 'Installer checksum mismatch.'
    prefix=$(cd "$release_dir/../../../.." && pwd)
    mode=--cli-only
    if [[ -f "$release_dir/APP_PATH" ]]; then
      mode=--app-only
      if [[ -x "$release_dir/t3" ]]; then mode=; fi
    fi
    args=(--prefix "$prefix")
    # A normal install keeps the app in /Applications or ~/Applications.
    if [[ "$prefix" == "$HOME/.local" ]]; then args=(); fi
    if [[ -n "$mode" ]]; then args+=("$mode"); fi
    # [#11] Bash 3.2 nounset rejects empty arrays; alternate-value expansion preserves zero arguments.
    # https://www.gnu.org/software/bash/manual/html_node/Shell-Parameter-Expansion.html
    bash "$installer" --version "$version" ${args[@]+"${args[@]}"} ${forwarded[@]+"${forwarded[@]}"}
    ;;
  doctor)
    status=0
    printf 'Installed version: '; cat "$release_dir/VERSION"
    printf 'Verify release provenance: gh attestation verify <asset> --repo rakutenanalytics/t3code\n'
    if [[ -f "$release_dir/signing-certificate.sha256" ]]; then
      printf 'Release signing certificate SHA-256: '; cat "$release_dir/signing-certificate.sha256"
    fi
    printf 'Release policy: ' ; cat "$release_dir/managed-policy.json"
    prefix=$(cd "$release_dir/../../../.." && pwd -P)
    # The identity file ships with the release, so app-only installs report it too.
    identity="$release_dir/app-identity.json"
    if [[ -f "$identity" ]]; then
      home_dir_name=$(plutil -extract homeDirName raw -o - "$identity")
      home_env_var=$(plutil -extract homeEnvVar raw -o - "$identity")
      profile_dir=$(plutil -extract userDataDirName raw -o - "$identity")
      choice_file="$HOME/Library/Application Support/$profile_dir/home-choice.json"
      saved_choice=$(plutil -extract home raw -o - "$choice_file" 2>/dev/null || true)
      # Same precedence as `t3safe home`: environment, then saved choice, then default.
      if [[ -n "${!home_env_var:-}" ]]; then
        data_dir=${!home_env_var}; home_source=environment
      elif [[ "$saved_choice" == official ]]; then
        data_dir="$HOME/.t3"; home_source='saved choice'
      else
        data_dir="$HOME/$home_dir_name"; home_source=default
        if [[ "$saved_choice" == isolated ]]; then home_source='saved choice'; fi
      fi
      printf 'Data directory: %s (source: %s; override with %s or "t3safe home")\n' "$data_dir" "$home_source" "$home_env_var"
      if [[ "$data_dir" == "$HOME/.t3" ]]; then
        printf 'Note: shares data with official T3 Code.\n'
      elif [[ "$data_dir" == "$HOME/.t3/"* ]]; then
        printf 'WARNING: data directory is inside the official T3 home; safe and official T3 would share state.\n'
        status=1
      fi
    else
      printf 'MISSING: %s\n' "$identity"; status=1
    fi
    # Earlier installers linked the CLI as `t3`, shadowing the official command.
    legacy_link="$prefix/bin/t3"
    if [[ -L "$legacy_link" && "$(readlink "$legacy_link")" == "$prefix/share/t3safe/"* ]]; then
      printf 'WARNING: legacy t3 link from an earlier t3safe install: %s. Rerun the installer to remove it.\n' "$legacy_link"
      status=1
    fi
    if [[ -x "$release_dir/t3" ]]; then
      printf 'Effective CLI policy: '
      "$release_dir/t3" managed-policy || status=1
    else
      printf 'App-only install: effective policy is embedded at build time; release policy shown above.\n'
    fi
    paths=("$release_dir")
    if [[ -f "$release_dir/APP_PATH" ]]; then paths+=("$(cat "$release_dir/APP_PATH")"); fi
    for path in "${paths[@]}"; do
      if [[ ! -e "$path" ]]; then printf 'MISSING: %s\n' "$path"; status=1; continue; fi
      attributes=$(xattr -lr "$path") || status=1
      if [[ "$attributes" == *com.apple.quarantine* ]]; then
        printf 'QUARANTINED: %s\n' "$path"; status=1
      else
        printf 'No quarantine: %s\n' "$path"
      fi
    done
    exit "$status"
    ;;
  help|--help|-h)
    printf '%s\n' 'Usage: t3safe update [installer options] | version | doctor | home [use-official|use-isolated] | <bundled T3 CLI command>'
    printf '%s\n' 'Any other command runs the bundled T3 CLI (CLI installs only), e.g. t3safe pair.'
    ;;
  *)
    [[ -x "$release_dir/t3" ]] || fail "Unknown command: $1 (no bundled CLI in this install)"
    exec "$release_dir/t3" "$@"
    ;;
esac
