#!/usr/bin/env bash
set -euo pipefail

script_path=${BASH_SOURCE[0]}
while [[ -L "$script_path" ]]; do
  script_directory=$(cd -P "$(dirname "$script_path")" && pwd)
  target=$(readlink "$script_path")
  if [[ "$target" = /* ]]; then script_path=$target; else script_path="$script_directory/$target"; fi
done
release_dir=$(cd -P "$(dirname "$script_path")" && pwd)
fail() { printf 't3safe: %s\n' "$*" >&2; exit 1; }
case "${1:-help}" in
  version)
    [[ -f "$release_dir/VERSION" ]] || fail 'No installed VERSION receipt.'
    cat "$release_dir/VERSION"
    ;;
  update)
    shift
    version=
    forwarded=()
    while [[ $# -gt 0 ]]; do
      if [[ "$1" == --version ]]; then
        [[ $# -ge 2 ]] || fail '--version needs a tag'
        version=$2
        shift 2
      else
        forwarded+=("$1")
        shift
      fi
    done
    work=$(mktemp -d "${TMPDIR:-/tmp}/t3safe-update.XXXXXX")
    trap 'rm -rf "$work"' EXIT
    curl_public() { curl --fail --silent --show-error --location --proto '=https' --proto-redir '=https' "$@"; }
    if [[ -z "$version" ]]; then
      curl_public https://api.github.com/repos/rakutenanalytics/t3code/releases/latest -o "$work/release.json"
      version=$(plutil -extract tag_name raw -o - "$work/release.json")
    fi
    [[ "$version" =~ ^v[0-9]+\.[0-9]+\.[0-9]+-safe\.[0-9]+$ ]] || fail 'Expected vX.Y.Z-safe.N.'
    release_url="https://github.com/rakutenanalytics/t3code/releases/download/$version"
    installer="$work/install.sh"
    curl_public "$release_url/SHA256SUMS" -o "$work/SHA256SUMS"
    curl_public "$release_url/install.sh" -o "$installer"
    expected=$(awk '$2 == "install.sh" || $2 == "./install.sh" { print $1 }' "$work/SHA256SUMS")
    [[ "$expected" =~ ^[a-fA-F0-9]{64}$ ]] || fail 'Missing or duplicate installer checksum.'
    actual=$(shasum -a 256 "$installer")
    [[ "${actual%% *}" == "$expected" ]] || fail 'Installer checksum mismatch.'
    prefix=$(cd "$release_dir/../../../.." && pwd)
    mode=--cli-only
    if [[ -f "$release_dir/APP_PATH" ]]; then
      mode=--app-only
      if [[ -x "$release_dir/t3" ]]; then mode=; fi
    fi
    args=(--prefix "$prefix")
    # A normal install keeps the app in /Applications or ~/Applications.
    if [[ "$prefix" == "$HOME/.local" ]]; then args=(); fi
    if [[ -n "$mode" ]]; then args+=("$mode"); fi
    bash "$installer" --version "$version" "${args[@]}" "${forwarded[@]}"
    ;;
  doctor)
    status=0
    printf 'Installed version: '; cat "$release_dir/VERSION"
    printf 'Verify release provenance: gh attestation verify <asset> --repo rakutenanalytics/t3code\n'
    printf 'Release policy: '; cat "$release_dir/managed-policy.json"
    prefix=$(cd "$release_dir/../../../.." && pwd)
    t3_path=$(command -v t3 || true)
    if [[ -n "$t3_path" ]]; then
      t3_directory=$(cd -P "$(dirname "$t3_path")" && pwd)
      if [[ "$t3_directory/" != "$prefix/"* ]]; then
        printf 'WARNING: t3 on PATH is outside the t3safe prefix: %s (expected under %s)\n' "$t3_path" "$prefix"
      fi
    fi
    if [[ -x "$release_dir/t3" ]]; then
      printf 'Effective CLI policy: '
      "$release_dir/t3" managed-policy || status=1
    else
      printf 'App-only install: effective policy is embedded at build time; release policy shown above.\n'
    fi
    paths=("$release_dir")
    if [[ -f "$release_dir/APP_PATH" ]]; then paths+=("$(cat "$release_dir/APP_PATH")"); fi
    for path in "${paths[@]}"; do
      if [[ ! -e "$path" ]]; then printf 'MISSING: %s\n' "$path"; status=1; continue; fi
      attributes=$(xattr -lr "$path") || status=1
      if [[ "$attributes" == *com.apple.quarantine* ]]; then
        printf 'QUARANTINED: %s\n' "$path"; status=1
      else
        printf 'No quarantine: %s\n' "$path"
      fi
    done
    exit "$status"
    ;;
  help|--help|-h) printf '%s\n' 'Usage: t3safe update [installer options] | version | doctor' ;;
  *) fail "Unknown command: $1" ;;
esac
